# ══════════════════════════════════════════════════════════════════════════════
# TASK MANAGER — VARIÁVEIS DE AMBIENTE (BACKEND)
# ══════════════════════════════════════════════════════════════════════════════
# Copie este arquivo para .env e preencha com as credenciais reais da sua infraestrutura:
#   cp .env.example .env

# Porta de execução do servidor NestJS (padrão local: 3000 | Render/Cloud: injetado via $PORT)
PORT=3000

# Conexão com o PostgreSQL (Supabase, Neon, Railway ou local)
# Em ambiente Supabase, utilize a porta do pooler (6543) com modo de transação:
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão direta com o PostgreSQL (porta 5432 - usada para migrações do Prisma)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Chave secreta criptográfica (HMAC SHA-256) para assinatura de tokens JWT
# Gere uma chave segura aleatória com: openssl rand -hex 32
JWT_SECRET="seu-jwt-secret-super-seguro-aqui-troque-em-producao"

# Chave de API do Google Gemini (necessária para recursos inteligentes de IA)
# Obtenha gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="sua-chave-api-google-gemini-aqui"

